# Copy to .env (local) / .env.production.local and fill in. Never commit real values.
# Every key below is actually read by the app — see lib/db.ts, lib/auth.ts,
# app/api/*, services/*, scripts/*. Nothing extra, nothing missing.

# Database — Neon (used in production AND any non-dev NODE_ENV, incl. Vercel build)
NEON_DATABASE_URL=
# Database — local Postgres (only used when NODE_ENV=development). Optional.
LOCAL_DATABASE_URL=

# REQUIRED in production. Stable random secret used to sign auth JWT cookies.
# Missing in production runtime throws on first sign/verify (not at import).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public URLs
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BASE_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Search-console verification (optional, used in app/layout.tsx metadata)
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Cloudinary (for profile images / uploads)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Cron protection — required if cron routes are enabled.
# Send as `Authorization: Bearer <CRON_SECRET>`. Generate like JWT_SECRET.
CRON_SECRET=

# AI title/tag generation (at least one OpenRouter key required for /api/tools/generate)
OPENROUTER_API_KEY_1=sk-or-v1-...
OPENROUTER_API_KEY_2=sk-or-v1-...
OPENROUTER_API_KEY_3=sk-or-v1-...

# Legacy/unused: GROQ_API_KEY is read by services/autoTag.service.ts but no key
# is currently configured. Leave empty unless that path is re-enabled.
GROQ_API_KEY=
